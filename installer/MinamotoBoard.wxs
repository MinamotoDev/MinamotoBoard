<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
 <Package Name="MinamotoBoard" Manufacturer="MinamotoDev" Version="0.3.0" Language="1033"
          UpgradeCode="8D1AF8D5-305C-4670-9E17-A0DB4FB394B3" Scope="perMachine" InstallerVersion="500" Codepage="936">
  <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of MinamotoBoard is already installed." />
  <MediaTemplate EmbedCab="yes" />
  <UIRef Id="BoardInstallerUI" />
  <Property Id="INSTALLFOLDER" Secure="yes">
   <RegistrySearch Id="ExistingInstallDirectory" Root="HKLM" Key="Software\MinamotoDev\Board" Name="InstallDirectory" Type="raw" Bitness="always64" />
  </Property>
  <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="both" />
  <!-- Used only from the UI of a new MSI to remove a related, different product.
       It delegates to Windows Installer and is never installed as an application. -->
  <Binary Id="MaintenanceBridge" SourceFile="$(var.MaintenanceSource)\BoardMaintenanceBridge.exe" />
  <CustomAction Id="RemoveRelatedProductFromUI" BinaryRef="MaintenanceBridge" ExeCommand="--from-installer" Execute="immediate" Return="asyncNoWait" Impersonate="yes" />
  <Icon Id="BoardIcon.exe" SourceFile="$(var.DocSource)\src\MinamotoBoard\Assets\MinamotoBoard.ico" />
  <Property Id="ARPPRODUCTICON" Value="BoardIcon.exe" />
  <Property Id="NETFXRELEASE" Secure="yes">
   <RegistrySearch Id="FindNetFx" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" Bitness="always64" />
  </Property>
  <Property Id="OSBUILD" Secure="yes">
   <RegistrySearch Id="FindWindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
  </Property>
  <Launch Condition="Installed OR (VersionNT64 AND OSBUILD &gt;= 19045)" Message="MinamotoBoard requires x64 Windows 10 22H2 or later." />
  <Launch Condition="Installed OR (NETFXRELEASE &gt;= &quot;#528040&quot;)" Message="MinamotoBoard requires .NET Framework 4.8 or later. This offline installer does not download runtimes." />
  <StandardDirectory Id="ProgramFiles64Folder">
   <Directory Id="MinamotoDevFolder" Name="MinamotoDev">
    <Directory Id="INSTALLFOLDER" Name="Board">
     <Component Id="MainExecutable" Guid="C414F76E-9B82-4A60-A17F-6A2AB04A14C9">
      <File Id="BoardExe" Source="$(var.AppSource)\MinamotoBoard.exe" KeyPath="yes" />
     </Component>
     <Component Id="ApplicationShortcut" Guid="E90AA183-DF79-4D63-9B36-20BB2F323414">
      <Shortcut Id="StartMenuShortcut" Directory="ApplicationMenuFolder" Name="MinamotoBoard" Target="[#BoardExe]" WorkingDirectory="INSTALLFOLDER" Advertise="no" Icon="BoardIcon.exe" IconIndex="0" />
      <RegistryValue Root="HKLM" Key="Software\MinamotoDev\Board" Name="InstallDirectory" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
     </Component>
     <Component Id="ApplicationConfig" Guid="88C5BFD9-2DCE-4B01-8021-2F91E745D05C">
      <File Source="$(var.AppSource)\MinamotoBoard.exe.config" KeyPath="yes" />
     </Component>
     <Component Id="PluginApi" Guid="580821B9-C4B7-49F0-A699-EB2BBEAF3637">
      <File Source="$(var.AppSource)\MinamotoBoard.PluginApi.dll" KeyPath="yes" />
     </Component>
     <Component Id="Instructions" Guid="F19B22A2-013C-4421-9EC9-17CB633CB6DD">
      <File Source="$(var.DocSource)\installer\README.txt" KeyPath="yes" />
     </Component>
     <Component Id="PluginInstructions" Guid="30EA243A-3ECC-4347-BFD3-EF65AD797B43">
      <File Source="$(var.DocSource)\docs\PLUGINS.md" KeyPath="yes" />
     </Component>
    </Directory>
   </Directory>
  </StandardDirectory>
  <StandardDirectory Id="ProgramMenuFolder">
   <Directory Id="ApplicationMenuFolder" Name="MinamotoBoard">
    <Component Id="MenuFolder" Guid="F2BFCFF6-E7E6-4F7B-A9AE-ECAADBF4994A">
     <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
     <RegistryValue Root="HKLM" Key="Software\MinamotoDev\Board" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
   </Directory>
  </StandardDirectory>
  <Feature Id="Board" Title="MinamotoBoard" Level="1">
   <ComponentRef Id="MainExecutable" /><ComponentRef Id="ApplicationShortcut" /><ComponentRef Id="ApplicationConfig" />
   <ComponentRef Id="PluginApi" /><ComponentRef Id="Instructions" />
   <ComponentRef Id="PluginInstructions" /><ComponentRef Id="MenuFolder" />
  </Feature>
 </Package>
</Wix>
