<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
 <PropertyGroup>
  <CodePage>65001</CodePage>
  <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  <OutputType>WinExe</OutputType><AssemblyName>BoardMaintenanceBridge</AssemblyName>
  <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget>
  <OutputPath>bin\$(Configuration)\</OutputPath><WarningLevel>4</WarningLevel><TreatWarningsAsErrors>true</TreatWarningsAsErrors><Optimize>true</Optimize>
  <ApplicationManifest>..\..\src\MinamotoBoard\app.manifest</ApplicationManifest>
  <ApplicationIcon>..\..\src\MinamotoBoard\Assets\MinamotoBoard.ico</ApplicationIcon>
 </PropertyGroup>
 <ItemGroup><Reference Include="System" /><Reference Include="System.Xml" /><Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" /><Compile Include="Program.cs" />
  <Compile Include="..\..\src\MinamotoBoard\Localization\Localizer.cs"><Link>Localizer.cs</Link></Compile>
  <EmbeddedResource Include="..\..\src\MinamotoBoard\Localization\zh-CN.xml"><LogicalName>MinamotoBoard.Localization.zh-CN.xml</LogicalName></EmbeddedResource>
  <EmbeddedResource Include="..\..\src\MinamotoBoard\Localization\zh-TW.xml"><LogicalName>MinamotoBoard.Localization.zh-TW.xml</LogicalName></EmbeddedResource>
  <EmbeddedResource Include="..\..\src\MinamotoBoard\Localization\ja-JP.xml"><LogicalName>MinamotoBoard.Localization.ja-JP.xml</LogicalName></EmbeddedResource>
  <EmbeddedResource Include="..\..\src\MinamotoBoard\Localization\en-US.xml"><LogicalName>MinamotoBoard.Localization.en-US.xml</LogicalName></EmbeddedResource></ItemGroup>
 <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
