<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
 <Fragment>
  <!-- Stock WixUI dialogs, artwork and localized text. Only navigation is wired here. -->
  <UI Id="BoardInstallerUI">
   <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
   <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
   <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
   <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
   <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
   <Property Id="ARPNOMODIFY" Value="1" />
   <DialogRef Id="ErrorDlg" />
   <DialogRef Id="FatalError" />
   <DialogRef Id="FilesInUse" />
   <DialogRef Id="MsiRMFilesInUse" />
   <DialogRef Id="PrepareDlg" />
   <DialogRef Id="ProgressDlg" />
   <DialogRef Id="ResumeDlg" />
   <DialogRef Id="UserExit" />
   <Publish Dialog="BoardExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
   <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" />
   <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
   <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
   <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_X64" Order="2" />
   <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
   <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="BoardVerifyReadyDlg" Order="4" Condition="WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
   <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
   <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />
   <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_X64" Order="3" />
   <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
   <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
   <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
   <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Property="WixUI_InstallMode" Value="Update" Order="2" Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
   <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="BoardVerifyReadyDlg" Order="3" />
   <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="BoardVerifyReadyDlg" Order="3" />
   <Publish Dialog="BoardVerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
   <Publish Dialog="BoardVerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT BOARD_DIRECT_REMOVE" />
   <InstallUISequence>
    <Show Dialog="override WelcomeDlg" Before="ProgressDlg" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
    <Show Dialog="override MaintenanceWelcomeDlg" Before="ProgressDlg" Condition="Installed AND NOT RESUME AND NOT Preselected AND NOT (REMOVE~=&quot;ALL&quot;)" />
    <Show Dialog="override ResumeDlg" Before="ProgressDlg" Condition="Installed AND (RESUME OR Preselected) AND NOT (REMOVE~=&quot;ALL&quot;)" />
    <Show Dialog="BoardVerifyReadyDlg" Before="ProgressDlg" Condition="BOARD_DIRECT_REMOVE OR BOARD_IS_UPDATE" />
    <Show Dialog="override UserExit" OnExit="cancel" Condition="NOT BOARD_REMOVE_RELATED" />
    <Custom Action="DeleteBoardUserData" After="ExecuteAction" Condition="Installed AND REMOVE~=&quot;ALL&quot; AND BOARD_DELETE_CONFIG=&quot;1&quot; AND NOT UPGRADINGPRODUCTCODE" />
   </InstallUISequence>
  </UI>
  <SetProperty Id="BOARD_DIRECT_REMOVE" Value="1" After="CostFinalize" Sequence="ui" Condition="Installed AND REMOVE~=&quot;ALL&quot;" />
  <SetProperty Id="WixUI_InstallMode" Value="Remove" After="SetBOARD_DIRECT_REMOVE" Sequence="ui" Condition="BOARD_DIRECT_REMOVE" />
  <SetProperty Id="BOARD_IS_UPDATE" Value="1" After="CostFinalize" Sequence="ui" Condition="NOT Installed AND WIX_UPGRADE_DETECTED AND NOT (REMOVE~=&quot;ALL&quot;)" />
  <SetProperty Id="WixUI_InstallMode" Action="SetBoardUpdateMode" Value="Update" After="SetBOARD_IS_UPDATE" Sequence="ui" Condition="BOARD_IS_UPDATE" />
  <UIRef Id="WixUI_Common" />
 </Fragment>
</Wix>
