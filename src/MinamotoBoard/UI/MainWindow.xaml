<Window x:Class="MinamotoBoard.UI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ink="clr-namespace:MinamotoBoard.Ink"
 Title="MinamotoBoard" Width="1100" Height="720" MinWidth="640" MinHeight="480"
 WindowStartupLocation="CenterScreen" Background="#236B45" Icon="/Assets/MinamotoBoard.ico"
 PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="MinWidth" Value="50" /><Setter Property="MinHeight" Value="50" />
   <Setter Property="Margin" Value="3" /><Setter Property="Padding" Value="8" />
   <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#173F2B" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.75" /></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.5" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WindowIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="50" /><Setter Property="Height" Value="50" />
   <Setter Property="Foreground" Value="White" /><Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
   <Setter Property="FontSize" Value="18" />
  </Style>
 </Window.Resources>
 <Grid x:Name="RootLayout" SizeChanged="OnBoardSizeChanged">
  <InkCanvas x:Name="Board" Background="#236B45" ClipToBounds="True" Focusable="True" />
  <Grid x:Name="PluginOverlay" ClipToBounds="True" />
  <ink:InstrumentOverlay x:Name="Instruments" ClipToBounds="True" IsHitTestVisible="False" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
   <Button Style="{StaticResource WindowIconButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="最小化" AutomationProperties.Name="最小化" />
   <Button x:Name="FullscreenButton" Style="{StaticResource WindowIconButton}" Content="&#xE73F;" Click="OnToggleFullscreen" ToolTip="退出全屏" AutomationProperties.Name="退出全屏" />
  </StackPanel>
  <Border x:Name="Toolbar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16" Padding="6"
   Background="#FCFDFB" BorderBrush="#DAE3DD" BorderThickness="1" CornerRadius="18">
   <DockPanel>
    <Button x:Name="ToolbarLeft" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" DockPanel.Dock="Left" Visibility="Collapsed" Click="OnToolbarLeft" ToolTip="向左滚动" AutomationProperties.Name="向左滚动" />
    <Button x:Name="ToolbarRight" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" DockPanel.Dock="Right" Visibility="Collapsed" Click="OnToolbarRight" ToolTip="向右滚动" AutomationProperties.Name="向右滚动" />
    <ScrollViewer x:Name="ToolbarScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
      PanningMode="HorizontalOnly" CanContentScroll="False" ScrollChanged="OnToolbarScrollChanged">
     <StackPanel x:Name="ToolsPanel" Orientation="Horizontal" HorizontalAlignment="Center" />
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Border x:Name="CollapsedToolbar" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
    Width="68" Height="68" CornerRadius="34" Background="#FCFDFB" BorderBrush="#DAE3DD" BorderThickness="1" Visibility="Collapsed">
   <Button x:Name="ShowToolbarButton" Click="OnShowToolbar" Margin="0" Padding="12" ToolTip="显示工具栏" AutomationProperties.Name="显示工具栏" />
  </Border>
  <Popup x:Name="ToolOptionsPopup" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" VerticalOffset="-12">
   <Border Background="#FCFDFB" BorderBrush="#CCD8D0" BorderThickness="1" CornerRadius="10" Padding="16" Width="300">
    <StackPanel x:Name="ToolOptionsPanel" />
   </Border>
  </Popup>
 </Grid>
</Window>
